    "require_upper_confidence_bound_below_target": true,
    "minimum_ai_detection_rate": 0.6,
    "require_lower_confidence_bound_above_target": true,
    "independently_verified_provenance": true,
    "no_overlap_with_calibration_or_model_training": true,
    "frozen_threshold_before_holdout": true
  },
